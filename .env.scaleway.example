# 复制为 .env.scaleway 后由 scripts/scaleway-interactive.sh 读取
# 也可直接 export 环境变量
API_KEY=change-me-to-a-random-32hex
OPENCODE_ZEN_API_KEY=sk-...-or-opencode-zen-key
OPENCODE_SERVER_PASSWORD=
# 后台管理默认关闭（极简）
OPENCODE_PROXY_MANAGE_BACKEND=false
OPENCODE_PROXY_AUTO_CLEANUP_CONVERSATIONS=false
OPENCODE_METRICS_ENABLED=false
# 可选
# OPENCODE_PROXY_PORT=8080
# OPENCODE_DISABLE_TOOLS=true
